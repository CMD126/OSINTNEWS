# OSINTNEWS — environment configuration
# Copy this file to ".env" (same folder) and fill in the keys you use.
# The CLI loads it automatically on startup; values already set in the real
# environment are never overwritten. ".env" itself is gitignored.

# AI / RAG providers — only the one you pass to --provider is needed
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Ollama (local, free) needs no key — just a running server:
#   python osintnews.py --cli --mode username --target johndoe --ai --provider ollama
